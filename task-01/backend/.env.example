DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/pos?schema=public&connection_limit=20&pool_timeout=20
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
EXPIRY_INTERVAL_MS=15000
RATE_LIMIT_MAX=300
TRUST_PROXY=0
LOG_LEVEL=info
# Required in production. Sent by a staff user via X-Admin-Key; never a VITE variable.
ADMIN_API_KEY=
# Dedicated disposable database, whose name must end in _test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/pos_test?schema=public&connection_limit=30&pool_timeout=30
