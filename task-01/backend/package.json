{
  "name": "@pos/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "node ../node_modules/prisma/build/index.js generate && node ../scripts/check-syntax.js",
    "db:generate": "node ../node_modules/prisma/build/index.js generate",
    "db:migrate": "node ../node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node prisma/seed.js",
    "test": "node ../node_modules/vitest/vitest.mjs run tests/unit --configLoader native",
    "test:db": "node ../node_modules/vitest/vitest.mjs run tests/integration tests/concurrency --configLoader native"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "vitest": "^4.1.11"
  }
}
