{
  "name": "task-01",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node scripts/local-db.js start",
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js --kill-others -n api,web -c cyan,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "test": "npm run test -w backend",
    "test:db": "npm run test:db -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "setup": "node scripts/setup-local.js",
    "db:test:migrate": "node scripts/test-migrate.js",
    "db:start": "node scripts/local-db.js start",
    "db:stop": "node scripts/local-db.js stop",
    "db:status": "node scripts/local-db.js status"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "pg": "8.23.0",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
}
